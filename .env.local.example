# Copy this to .env.local for local dev. NEVER commit .env.local.
# In production, set these in Vercel dashboard under Settings → Environment Variables.

# The passcode users will type into the lock screen.
# Pick something memorable but not obvious. Example: CHEQ-LIONS-2026
ACCESS_PASSWORD=CHANGE_ME

# A random session token set as the auth cookie after correct password.
# Generate with: openssl rand -hex 32
# This should be DIFFERENT from ACCESS_PASSWORD and never shared.
ACCESS_TOKEN=CHANGE_ME_TO_RANDOM_HEX_STRING
